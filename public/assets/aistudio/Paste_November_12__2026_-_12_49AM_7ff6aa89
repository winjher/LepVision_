function adminListUsers(actor) {
  requireAdmin_(actor);
  return readUsers_().map(u => ({
    username: u.username, role: u.role, name: u.name, phone: u.phone, email: u.email,
    gcash: u.gcash, organization: u.organization, address: u.address, farm: u.farm,
    idType: u.idType, created: fmt_(u.created)
  }));
}

function adminCreateFarmOwner(actor, d) {
  requireAdmin_(actor);
  d = d || {};
  const u = String(d.username || '').trim().toLowerCase(), pw = String(d.password || '');
  if (u.length < 3 || pw.length < 4) throw new Error('Username 3+ and password 4+ characters.');
  if (!farmExists_(d.farm)) throw new Error('Choose the farm this owner manages.');
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const res = registerUser_('farmowner', u, pw, {name: d.name, phone: d.phone, email: d.email, org: d.organization, addr: d.address});
    if (!res.ok) throw new Error(res.msg);
    setUserFields_(u, {farm: d.farm, mustChange: 1});
  } finally { lock.releaseLock(); }
  logActivity(actor, 'admin', 'Created farm owner', u + ' → ' + d.farm);
  return {ok: true};
}

function adminUpdateUser(actor, d) {
  requireAdmin_(actor);
  d = d || {};
  const target = getUser_(String(d.username || ''));
  if (!target) throw new Error('User not found.');
  const f = {};
  ['name', 'phone', 'email', 'gcash', 'organization', 'address'].forEach(k => {
    if (d[k] !== undefined) f[k] = String(d[k]).trim();
  });
  if (d.role !== undefined) {
    if (ALL_ROLES.indexOf(d.role) < 0) throw new Error('Invalid role.');
    f.role = d.role;
  }
  if (d.farm !== undefined) {
    if (d.farm && !farmExists_(d.farm)) throw new Error('Invalid farm.');
    f.farm = d.farm || '';
  }
  if (d.password) {
    if (String(d.password).length < 4) throw new Error('Password must be 4+ characters.');
    const salt = Utilities.getUuid();
    f.salt = salt;
    f.pwHash = hash_(String(d.password), salt);
    f.mustChange = 1;   // the user must set their own password at next login
  }
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try { setUserFields_(target.username, f); } finally { lock.releaseLock(); }
  logActivity(actor, 'admin', 'Edited user', target.username);
  return {ok: true};
}

// ===== FARM PROFILES (built-in farms + farms created by breeders/admin) =====

function farmProfiles_() { return cfg_('farmProfiles') || {}; }
function farmExists_(name) { return !!name && (!!FARM_DEFAULTS[name] || !!farmProfiles_()[name]); }

function cleanFarmProfile_(name, d) {
  d = d || {};
  const num = (v, min, max, dflt) => { const n = parseFloat(v); return isFinite(n) ? Math.min(max, Math.max(min, n)) : dflt; };
  const lat = parseFloat(d.lat), lng = parseFloat(d.lng);
  const sp = Array.isArray(d.sp) ? d.sp : String(d.sp || '').split(',');
  return {
    name: name,
    loc: String(d.loc || '').trim().slice(0, 120),
    tel: String(d.tel || '').trim().slice(0, 40),
    hours: String(d.hours || '').trim().slice(0, 60),
    p: num(d.p, 0, 100000, 150),
    c: Math.round(num(d.c, 1, 500, 20)),
    lat: isFinite(lat) ? lat : null,
    lng: isFinite(lng) ? lng : null,
    sp: sp.map(s => String(s).trim()).filter(Boolean).slice(0, 12)
  };
}

function saveFarmProfile_(name, prof) {
  const all = farmProfiles_();
  all[name] = prof;
  setConfig_('farmProfiles', all);
}

// A breeder edits ONLY the farm designated to their account
function updateMyFarm(actor, d) {
  const u = getUser_(actor);
  if (!u || u.role !== 'breeder') throw new Error('Only breeders can edit their farm profile here.');
  if (!u.farm) throw new Error('No farm is assigned to your account yet. Ask the administrator.');
  return saveFarmFor_(actor, u.farm, d, false);
}

// Admin edits or creates any farm profile
function adminSaveFarm(actor, name, d) {
  requireAdmin_(actor);
  name = String(name || '').trim();
  if (!name) throw new Error('Enter the farm name.');
  return saveFarmFor_(actor, name, d, true);
}

function saveFarmFor_(actor, name, d, asAdmin) {
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  let prof;
  try {
    const existing = farmProfiles_()[name] || {};
    prof = cleanFarmProfile_(name, Object.assign({}, existing, d || {}));
    saveFarmProfile_(name, prof);
  } finally { lock.releaseLock(); }
  logActivity(actor, asAdmin ? 'admin' : 'breeder', 'Farm profile saved', name);
  return {ok: true, farm: prof};
}

// ===== PER-BREEDER CATALOG =====

function catKey_(b) { return 'catalog|' + b; }

function getCatalogs_() {
  const out = {};
  sh('Config').getDataRange().getValues().slice(1).forEach(r => {
    const k = String(r[0]);
    if (k.indexOf('catalog|') !== 0) return;
    try { out[k.slice(8)] = JSON.parse(r[1]); } catch (e) {}
  });
  return out;
}

function toLotRow_(l) {
  return [l.id, l.breeder, l.sp, l.qty, l.left, l.price, new Date(l.created), new Date(l.exp), l.notes || ''];
}

// Breeder sets their own price and/or flood flag for one species
function setCatalogItem(actor, sp, patch) {
  const u = getUser_(actor);
  if (!u || u.role !== 'breeder') throw new Error('Only breeders can set catalog prices.');
  sp = String(sp || '');
  if (sp.indexOf('Butterfly-') !== 0) throw new Error('Unknown species.');
  patch = patch || {};
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  let item;
  try {
    const cat = getCatalogs_()[actor] || {};
    item = Object.assign({price: 50, flooded: false}, cat[sp] || {});
    if (patch.price !== undefined) {
      const p = parseFloat(patch.price);
      if (!(p >= 0)) throw new Error('Enter a valid price.');
      item.price = p;
      // Live listings of this species follow the new price until the next notice
      const live = readJson_('Lots').filter(l => l.breeder === actor && l.sp === sp && l.left > 0);
      live.forEach(l => { l.price = p; });
      upsert_('Lots', 'id', live, toLotRow_);
    }
    if (patch.flooded !== undefined) item.flooded = !!patch.flooded;
    cat[sp] = item;
    setConfig_(catKey_(actor), cat);
  } finally { lock.releaseLock(); }
  logActivity(actor, 'breeder', 'Catalog update', sp + ' ' + JSON.stringify(patch));
  return {ok: true, item: item};
}

// Post fresh pupae. The price comes from the breeder's catalog, never from the client.
function postFreshPupae(actor, d) {
  const u = getUser_(actor);
  if (!u || u.role !== 'breeder') throw new Error('Only breeders can post fresh pupae.');
  d = d || {};
  const sp = String(d.sp || ''), qty = parseInt(d.qty, 10);
  if (sp.indexOf('Butterfly-') !== 0) throw new Error('Choose a species.');
  if (!(qty >= 1)) throw new Error('Enter the exact number of pupae.');
  if (!d.qaPassed) throw new Error('Complete every quality assurance check first.');
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  let lot;
  try {
    const item = (getCatalogs_()[actor] || {})[sp] || {price: 50, flooded: false};
    if (item.flooded) throw new Error('This species is flooded. Turn off the flood flag in Manage prices first.');
    const now = Date.now();
    lot = {id: 'L' + now.toString(36), breeder: actor, sp: sp, qty: qty, left: qty, price: item.price,
      notes: String(d.notes || '').slice(0, 300), created: now, exp: now + 2 * 864e5};
    upsert_('Lots', 'id', [lot], toLotRow_);
  } finally { lock.releaseLock(); }
  logActivity(actor, 'breeder', 'Post fresh pupae', sp + ' x' + qty + ' @' + lot.price);
  return lot;
}

// Breeder sets the exact number of pupae still available (0 = withdraw)
function setLotLeft(actor, id, n) {
  const u = getUser_(actor);
  if (!u || u.role !== 'breeder') throw new Error('Only breeders can change listing counts.');
  n = parseInt(n, 10);
  if (!(n >= 0)) throw new Error('Enter a valid number.');
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  let l;
  try {
    l = readJson_('Lots').find(x => x.id === String(id));
    if (!l || l.breeder !== actor) throw new Error('Listing not found.');
    l.qty = l.qty - l.left + n;
    l.left = n;
    upsert_('Lots', 'id', [l], toLotRow_);
  } finally { lock.releaseLock(); }
  logActivity(actor, 'breeder', 'Set pupae count', l.id + ' now ' + n);
  return {ok: true};
}

// ===== SALES RECORD =====
// Completed (Received) orders only. Admin sees all, a breeder sees their own sales,
// a buyer sees their own purchases. Everyone else gets an empty list.
function salesRecordFor_(u) {
  if (!u) return [];
  const isAdm = u.role === 'admin';
  const isSeller = u.role === 'breeder';
  const isBuyer = BUYER_ROLES.indexOf(u.role) > -1;
  if (!isAdm && !isSeller && !isBuyer) return [];
  return readJson_('Orders')
    .filter(o => o.status === 'Received')
    .filter(o => isAdm || (isSeller && o.breeder === u.username) || (isBuyer && o.buyer === u.username))
    .map(o => ({
      id: o.id, date: o.receivedAt || o.created, sp: o.sp, qty: o.qty, price: o.price, total: o.total,
      breeder: o.breeder, sellerName: o.sellerName || o.breeder,
      buyer: o.buyer, buyerName: o.buyerName || o.buyer
    }))
    .sort((a, b) => (b.date || 0) - (a.date || 0));
}

// ===== STATE (polling) =====

function parkCfg_() { return cfg_('park') || {}; }

// Seats and price: farm profile first, then park override, then built-in default
function farmCap_(f, park) {
  const pr = farmProfiles_()[f];
  if (pr && pr.c != null) return pr.c;
  const o = (park.farms && park.farms[f]) || {};
  if (o.c != null) return o.c;
  return (FARM_DEFAULTS[f] || {c: 20}).c;
}
function farmPrice_(f, park) {
  const pr = farmProfiles_()[f];
  if (pr && pr.p != null) return pr.p;
  const o = (park.farms && park.farms[f]) || {};
  if (o.p != null) return o.p;
  return (FARM_DEFAULTS[f] || {p: 150}).p;
}

function readRes_() { return readJson_('Reservations'); }

function upsertRes_(r) {
  upsert_('Reservations', 'ref', [r], x => [x.ref, x.user, x.farm, x.name, x.phone, x.date, x.slot, x.n, x.total, x.status, x.payRef || '']);
}

function booked_(f, date, slot, exclude) {
  return readRes_()
    .filter(r => LIVE.indexOf(r.status) > -1 && r.farm === f && r.date === date && r.slot === slot && r.ref !== exclude)
    .reduce((a, r) => a + (r.n || 0), 0);
}

function canManage_(u, r) { return !!u && (u.role === 'admin' || (u.role === 'farmowner' && u.farm === r.farm)); }
function canSee_(u, r) { return !!u && (u.username === r.user || canManage_(u, r)); }

// Hide contact details from people who are not part of the booking
function redact_(r) {
  const x = Object.assign({}, r);
  delete x.phone; delete x.email; delete x.payRef; delete x.notes;
  return x;
}

// ===== SEAT CAPACITY (per farm, per date range) =====

function capRules_() { return cfg_('capRules') || {}; }

// Seats per slot for a farm on a date. A rule with cap 0 closes that farm on those dates.
function capacityFor_(f, date, park, rules) {
  let cap = farmCap_(f, park);
  ((rules || {})[f] || []).forEach(r => { if (date >= r.from && date <= r.to) cap = r.cap; });
  return cap;
}

// Seats already booked, keyed "farm|date|slot". Counts only, no guest details.
function bookedMap_() {
  const m = {};
  readRes_().forEach(r => {
    if (LIVE.indexOf(r.status) < 0) return;
    const k = r.farm + '|' + r.date + '|' + r.slot;
    m[k] = (m[k] || 0) + (r.n || 0);
  });
  return m;
}

function getState(actor) {
  const me = getUser_(actor);
  const users = {};
  readUsers_().forEach(u => { users[u.username] = u.username === actor ? fullUser_(u) : publicUser_(u); });
  const cfg = {};
  sh('Config').getDataRange().getValues().slice(1).forEach(r => {
    try { cfg[r[0]] = JSON.parse(r[1]); } catch (e) {}
  });
  const seeOrder = o => !!me && (me.role === 'admin' || o.buyer === actor || o.breeder === actor);
  return {
    users: users,
    catalog: getCatalogs_(),
    salesRecord: salesRecordFor_(me),
    park: cfg.park || {},
    capRules: cfg.capRules || {},
    farms: farmProfiles_(),
    booked: bookedMap_(),
    lots: readJson_('Lots'),
    orders: readJson_('Orders').filter(seeOrder),
    // Visitors see their own bookings, farm owners see their farm, admins see all
    reservations: readRes_().filter(r => canSee_(me, r))
  };
}

// Only park settings are saved from the client. Farm owners use setFarmCapacity instead.
function saveState(actor, st) {
  const u = getUser_(actor);
  if (!u) throw new Error('Please log in first.');
  if (['breeder', 'admin'].indexOf(u.role) > -1 && st && st.park) {
    const lock = LockService.getScriptLock(); lock.waitLock(20000);
    try { setConfig_('park', st.park); } finally { lock.releaseLock(); }
  }
  return true;
}

function datesBetween_(from, to) {
  const out = [], d = new Date(from + 'T00:00:00Z'), end = new Date(to + 'T00:00:00Z');
  for (; d <= end && out.length < 400; d.setUTCDate(d.getUTCDate() + 1)) out.push(d.toISOString().slice(0, 10));
  return out;
}

// Farm owner sets seats per slot for date ranges on THEIR farm (admin can choose any farm).
// rules: [{from:'YYYY-MM-DD', to:'YYYY-MM-DD', cap:0..500, label}]. cap 0 closes the farm on those dates.
function setFarmCapacity(actor, farmName, rules) {
  const u = getUser_(actor);
  if (!u || (u.role !== 'farmowner' && u.role !== 'admin')) throw new Error('Only farm owners can set seat capacity.');
  const farm = u.role === 'admin' ? String(farmName || '') : u.farm;
  if (!farmExists_(farm)) throw new Error('No farm is assigned to this account.');
  if (!Array.isArray(rules)) throw new Error('Invalid capacity rules.');
  const today = today_();
  const clean = rules.map(r => {
    const from = String(r.from || ''), to = String(r.to || '');
    const cap = parseInt(r.cap, 10);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(from) || !/^\d{4}-\d{2}-\d{2}$/.test(to)) throw new Error('Use valid dates.');
    if (from > to) throw new Error('The "From" date must be on or before the "To" date.');
    if (to < today) throw new Error('Rules must end today or later.');
    if (!(cap >= 0 && cap <= 500)) throw new Error('Seats per slot must be 0 to 500 (0 closes the farm).');
    return {from: from, to: to, cap: cap, label: String(r.label || '').slice(0, 60)};
  }).sort((a, b) => a.from < b.from ? -1 : 1);
  for (let i = 1; i < clean.length; i++) {
    if (clean[i].from <= clean[i - 1].to) throw new Error('Date ranges overlap. Split them so each date has one rule.');
  }

  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  const warnings = [];
  try {
    const all = cfg_('capRules') || {};
    all[farm] = clean;
    setConfig_('capRules', all);
    const booked = bookedMap_();
    clean.forEach(r => datesBetween_(r.from, r.to).forEach(date => SLOTS.forEach(s => {
      const used = booked[farm + '|' + date + '|' + s] || 0;
      if (used > r.cap) warnings.push(date + ' ' + s.split(' - ')[0] + ': ' + used + ' booked, limit ' + r.cap);
    })));
  } finally { lock.releaseLock(); }

  logActivity(actor, u.role, 'Set seat capacity', farm + ' · ' + clean.length + ' rule(s)');
  return {ok: true, rules: clean, warnings: warnings.slice(0, 10)};
}

// ===== BUYER ORDERS =====

function toOrderRow_(o) {
  return [o.id, o.buyer, o.breeder, o.sp, o.qty, o.total, o.status, o.payRef || '', new Date(o.created)];
}

function emailOf_(username) {
  const u = getUser_(username);
  return u ? u.email : '';
}

// items: [{breeder, sp, qty, lotId?}]. Stock comes from live, unflooded listings, oldest first.
function placeOrder(actor, items) {
  const u = getUser_(actor);
  if (!u || BUYER_ROLES.indexOf(u.role) < 0) throw new Error('Only buyers can place orders.');
  if (!u.phone || !u.address) throw new Error('Add your phone number and address in More → Edit profile first.');
  if (u.role === 'buyer' && !u.idNo) throw new Error('Your buyer account has no valid ID on file. Please contact the administrator.');
  if (!Array.isArray(items) || !items.length) throw new Error('Your cart is empty.');

  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  const orders = [];
  const lotsChanged = [];
  try {
    const cats = getCatalogs_(), now = Date.now();
    const lots = readJson_('Lots').filter(l => l.left > 0 && now < l.exp &&
      !((cats[l.breeder] || {})[l.sp] || {}).flooded);
    items.forEach(it => {
      const sp = String(it.sp || ''), b = String(it.breeder || '');
      let need = parseInt(it.qty, 10);
      if (!(need >= 1)) throw new Error('Enter a valid quantity.');
      if (((cats[b] || {})[sp] || {}).flooded) throw new Error(sp.replace('Butterfly-', '') + ' is flooded and cannot be bought right now.');
      const pool = lots.filter(l => l.breeder === b && l.sp === sp && (!it.lotId || l.id === it.lotId))
        .sort((x, y) => x.created - y.created);
      const avail = pool.reduce((a, l) => a + l.left, 0);
      if (need > avail) throw new Error('Only ' + avail + ' pupae left for ' + sp.replace('Butterfly-', '') + '.');
      pool.forEach(l => {
        if (need <= 0) return;
        const take = Math.min(need, l.left);
        need -= take; l.left -= take;
        if (lotsChanged.indexOf(l) < 0) lotsChanged.push(l);
        orders.push({
          id: 'OR' + Utilities.getUuid().replace(/-/g, '').slice(0, 8).toUpperCase(),
          lot: l.id, buyer: actor, buyerName: u.name, buyerPhone: u.phone, buyerEmail: u.email,
          buyerAddress: u.address, buyerIdType: u.idType || '', breeder: b, sellerName: '', sellerPhone: '',
          sp: sp, qty: take, price: l.price, total: take * l.price,
          status: 'Awaiting Payment', payRef: '', created: now
        });
      });
    });
    orders.forEach(o => {
      const s = getUser_(o.breeder) || {};
      o.sellerName = s.name || o.breeder; o.sellerPhone = s.phone || '';
    });
    upsert_('Lots', 'id', lotsChanged, toLotRow_);
    upsert_('Orders', 'id', orders, toOrderRow_);
  } finally { lock.releaseLock(); }

  orders.forEach(o => {
    const what = o.qty + ' × ' + o.sp.replace('Butterfly-', '') + ' at ₱' + Number(o.price).toFixed(2) + ' each (₱' + Number(o.total).toFixed(2) + ')';
    mail_(emailOf_(o.breeder), 'New pupae order ' + o.id,
      o.buyerName + ' ordered ' + what + '.\n\nBuyer contact: ' + o.buyerPhone + ' · ' + o.buyerEmail +
      '\nAddress: ' + o.buyerAddress + '\n\nThe buyer will pay via GCash. Confirm the payment in the app under Pupae → Orders.');
    mail_(o.buyerEmail, 'Order ' + o.id + ' placed',
      'Thank you. You ordered ' + what + ' from ' + o.sellerName + '.\nSeller contact: ' + o.sellerPhone +
      '\n\nPay via GCash and submit the reference number in the app to complete the order.');
    logActivity(actor, u.role, 'Order placed', o.id + ' ' + o.sp + ' x' + o.qty + ' from ' + o.breeder);
  });
  return orders;
}

// Actions: submitPay (buyer) · cancel (buyer or seller) · received (seller or admin)
function updateOrder(actor, id, action, d) {
  const u = getUser_(actor);
  if (!u) throw new Error('Please log in first.');
  d = d || {};
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  let o, msg = '';
  try {
    const all = readJson_('Orders');
    o = all.find(x => x.id === String(id));
    if (!o) throw new Error('Order not found.');
    const isBuyer = o.buyer === actor, isSeller = o.breeder === actor || u.role === 'admin';
    const notAllowed = () => new Error('This action is not allowed for the current status.');

    if (action === 'submitPay') {
      if (!isBuyer || o.status !== 'Awaiting Payment') throw notAllowed();
      const v = String(d.payRef || '').replace(/\s/g, '');
      if (!/^\d{10,13}$/.test(v)) throw new Error('Enter the 10–13 digit GCash reference number.');
      if (all.some(x => x.id !== o.id && x.payRef === v)) throw new Error('That reference number was already used.');
      o.payRef = v; o.status = 'Paid – Awaiting Receipt';
      msg = o.buyerName + ' paid order ' + o.id + ' (GCash ref ' + v + '). Please confirm receipt.';
    } else if (action === 'cancel') {
      if (!(isBuyer || isSeller) || o.status !== 'Awaiting Payment') throw notAllowed();
      o.status = 'Cancelled';
      const l = readJson_('Lots').find(x => x.id === o.lot);
      if (l) { l.left += o.qty; upsert_('Lots', 'id', [l], toLotRow_); }
      msg = 'Order ' + o.id + ' was cancelled. ' + o.qty + ' pupae returned to stock.';
    } else if (action === 'received') {
      if (!isSeller || o.status !== 'Paid – Awaiting Receipt') throw notAllowed();
      o.status = 'Received';
      o.receivedAt = Date.now();
      msg = 'Payment for order ' + o.id + ' was received. Thank you!';
    } else {
      throw new Error('Unknown action.');
    }
    upsert_('Orders', 'id', [o], toOrderRow_);
  } finally { lock.releaseLock(); }

  mail_(emailOf_(o.breeder), 'Order ' + o.id + ' – ' + o.status, msg);
  mail_(o.buyerEmail, 'Order ' + o.id + ' – ' + o.status, msg);
  logActivity(actor, u.role, 'Order ' + action, o.id + ' → ' + o.status);
  return {status: o.status};
}

// ===== FARM VISITS: availability, approval, payment =====

function ownersOf_(f) { return readUsers_().filter(u => u.role === 'farmowner' && u.farm === f && u.email).map(u => u.email); }

function gcashOf_(f, park) {
  if (park.gNo) return park.gNo;
  const o = readUsers_().find(u => u.role === 'farmowner' && u.farm === f && u.gcash);
  return (o && o.gcash) || 'the farm (ask via messages)';
}

function addMsg_(ref, from, text) {
  sh('Messages').appendRow([new Date(), ref, from, String(text).slice(0, 800)]);
}

function mail_(to, subject, body) {
  if (!to || (Array.isArray(to) && !to.length)) return;
  try { MailApp.sendEmail(Array.isArray(to) ? to.join(',') : to, subject, body); }
  catch (e) { Logger.log('Mail failed: ' + e); }
}

// AI writes friendly wording only when a Gemini key is set; facts always come from the rules
function draftText_(facts, fallback) {
  const props = PropertiesService.getScriptProperties();
  const key = props.getProperty('GEMINI_API_KEY');
  if (!key) return fallback;
  try {
    const model = props.getProperty('GEMINI_MODEL') || 'gemini-2.0-flash';
    const prompt = 'Write one short, friendly, professional message (max 2 sentences, no emojis) for a butterfly farm visitor. ' +
      'Use only these facts and do not invent anything: ' + facts;
    const res = UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/' + model + ':generateContent?key=' + key, {
      method: 'post', contentType: 'application/json',
      payload: JSON.stringify({contents: [{parts: [{text: prompt}]}]}), muteHttpExceptions: true
    });
    if (res.getResponseCode() !== 200) return fallback;
    const text = JSON.parse(res.getContentText()).candidates[0].content.parts[0].text.trim();
    return text || fallback;
  } catch (e) { return fallback; }
}

// Visitor submits a request. The seat count decides Awaiting Approval or Full automatically.
function requestReservation(actor, d) {
  const u = getUser_(actor);
  if (!u) throw new Error('Please log in first.');
  d = d || {};
  const f = String(d.farm || ''), date = String(d.date || ''), slot = String(d.slot || '');
  const n = parseInt(d.n, 10);
  const name = String(d.name || '').trim(), phone = String(d.phone || '').replace(/\s/g, '');
  if (!farmExists_(f)) throw new Error('Please choose a farm.');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || date <= today_()) throw new Error('Choose a date from tomorrow onward.');
  if (SLOTS.indexOf(slot) < 0) throw new Error('Please select a time slot.');
  if (!(n >= 1)) throw new Error('Enter the number of visitors.');
  if (!name || phone.length < 7) throw new Error('Enter your name and a valid phone number.');
  if (d.terms !== true) throw new Error('Please agree to the terms.');

  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  let res, remaining;
  try {
    const park = parkCfg_();
    if ((park.closed || []).indexOf(date) > -1) throw new Error('This farm is closed on that date.');
    const cap = capacityFor_(f, date, park, capRules_());
    if (cap <= 0) throw new Error('This farm is closed on that date.');
    if (n > cap) throw new Error('Visitors must be 1 to ' + cap + ' for this time slot.');
    remaining = cap - booked_(f, date, slot, '');
    res = {
      ref: 'BK' + Date.now().toString(36).toUpperCase().slice(-6), user: actor, farm: f, name: name, phone: phone,
      email: String(d.email || u.email || '').trim(), purpose: String(d.purpose || ''), date: date, slot: slot, n: n,
      notes: String(d.notes || '').slice(0, 300), total: n * farmPrice_(f, park),
      status: n <= remaining ? 'Awaiting Approval' : 'Full', payRef: '', note: '', created: Date.now()
    };
    upsertRes_(res);
  } finally { lock.releaseLock(); }

  const left = Math.max(remaining, 0);
  const facts = n + ' visitor(s) at ' + f + ', ' + date + ', ' + slot;
  const message = res.status === 'Full'
    ? draftText_('The slot is FULL with only ' + left + ' seat(s) left. Apologize and ask them to pick another time. ' + facts + '.',
        'Sorry, ' + slot + ' on ' + date + ' is full at ' + f + ' (' + left + ' seat(s) left). Please choose another time.')
    : draftText_('Seats are AVAILABLE. Tell them the request was sent to the farm owner for approval. ' + facts + '.',
        'Good news! ' + n + ' seat(s) are available for ' + slot + ' on ' + date + ' at ' + f + '. Your request has been sent to the farm owner for approval.');

  addMsg_(res.ref, 'System', message);
  if (res.status === 'Awaiting Approval') {
    mail_(ownersOf_(f), 'New visit request ' + res.ref,
      name + ' requested ' + n + ' visitor(s) at ' + f + ' on ' + date + ', ' + slot + '.\nApprove it in the app: Orders tab.');
  }
  mail_(res.email, 'Booking ' + res.ref + ' – ' + res.status, message);
  logActivity(actor, u.role, 'Park request', res.ref + ' | ' + res.status);
  return {ref: res.ref, status: res.status, message: message};
}

// Actions: approve, reject, confirm (farm owner of that farm, or admin) · submitPay, cancel (visitor)
function updateReservation(actor, ref, action, d) {
  const u = getUser_(actor);
  if (!u) throw new Error('Please log in first.');
  d = d || {};
  let r, msg = '';
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const all = readRes_();
    r = all.find(x => x.ref === ref);
    if (!r) throw new Error('Reservation not found.');
    const mine = r.user === actor, mgr = canManage_(u, r);
    const park = parkCfg_();
    const notAllowed = () => new Error('This action is not allowed for the current status.');

    if (action === 'submitPay') {
      if (!mine || r.status !== 'Pending Payment') throw notAllowed();
      const v = String(d.payRef || '').replace(/\s/g, '');
      if (!/^\d{10,13}$/.test(v)) throw new Error('Enter the 10–13 digit GCash reference number.');
      if (all.some(x => x.ref !== ref && x.payRef === v)) throw new Error('That reference number was already used.');
      r.payRef = v; r.status = 'Payment Submitted';
      msg = r.name + ' submitted GCash reference ' + v + ' for booking ' + r.ref + '. Please verify and confirm.';
    } else if (action === 'approve') {
      if (!mgr || r.status !== 'Awaiting Approval') throw notAllowed();
      const rem = capacityFor_(r.farm, r.date, park, capRules_()) - booked_(r.farm, r.date, r.slot, r.ref);
      if (r.n <= rem) {
        r.status = 'Pending Payment';
        msg = 'Your booking ' + r.ref + ' for ' + r.date + ', ' + r.slot + ' is approved. Please pay ₱' +
          Number(r.total).toFixed(2) + ' via GCash to ' + gcashOf_(r.farm, park) + ' and submit the reference number in the Visits tab.';
      } else {
        r.status = 'Full';
        msg = 'Sorry, ' + r.slot + ' on ' + r.date + ' filled up before approval. Please choose another time.';
      }
    } else if (action === 'reject') {
      if (!mgr || ['Awaiting Approval', 'Pending Payment', 'Payment Submitted'].indexOf(r.status) < 0) throw notAllowed();
      r.status = 'Rejected';
      r.note = String(d.note || '').slice(0, 300);
      msg = 'Your booking ' + r.ref + ' was not approved.' + (r.note ? ' Reason: ' + r.note : '');
    } else if (action === 'confirm') {
      if (!mgr || r.status !== 'Payment Submitted') throw notAllowed();
      r.status = 'Confirmed';
      msg = 'Payment received. Booking ' + r.ref + ' is confirmed for ' + r.date + ', ' + r.slot + '. See you there!';
    } else if (action === 'cancel') {
      if (!(mine || mgr) || ['Rejected', 'Cancelled', 'Confirmed', 'Full'].indexOf(r.status) > -1) throw notAllowed();
      r.status = 'Cancelled';
      msg = 'Booking ' + r.ref + ' was cancelled.';
    } else {
      throw new Error('Unknown action.');
    }
    r.decidedBy = u.name || actor;
    r.decidedAt = Date.now();
    upsertRes_(r);
  } finally { lock.releaseLock(); }

  const text = draftText_('Booking status update to tell the visitor kindly: ' + msg, msg);
  addMsg_(r.ref, 'System', text);
  if (action === 'submitPay') mail_(ownersOf_(r.farm), 'Payment submitted – ' + r.ref, msg);
  else mail_(r.email, 'Booking ' + r.ref + ' – ' + r.status, text);
  logActivity(actor, u.role, 'Reservation ' + action, r.ref + ' → ' + r.status);
  return {status: r.status, message: text};
}

function getMessages(actor, ref) {
  const u = getUser_(actor), r = readRes_().find(x => x.ref === ref);
  if (!r || !canSee_(u, r)) throw new Error('Not allowed.');
  return sh('Messages').getDataRange().getValues().slice(1)
    .filter(m => m[1] === ref)
    .map(m => ({time: fmt_(m[0]), from: String(m[2]), text: String(m[3])}));
}

function sendMessage(actor, ref, text) {
  const u = getUser_(actor), r = readRes_().find(x => x.ref === ref);
  if (!r || !canSee_(u, r)) throw new Error('Not allowed.');
  const t = String(text || '').trim();
  if (!t) throw new Error('Message is empty.');
  const visitor = r.user === actor;
  const from = visitor ? (u.name || actor) : ((u.role === 'admin' ? 'Admin' : (u.name || 'Farm owner')) + ' · ' + r.farm);
  addMsg_(ref, from, t);
  mail_(visitor ? ownersOf_(r.farm) : r.email, 'Booking ' + ref + ' – new message', from + ' wrote:\n\n' + t);
  return true;
}

// ===== AI CLASSIFICATION: model server connection =====

function cnnConfig_() {
  const p = PropertiesService.getScriptProperties();
  const url = (p.getProperty('CNN_API_URL') || '').trim().replace(/\/+$/, '');
  const token = (p.getProperty('CNN_API_TOKEN') || '').trim();
  if (!url || !token) throw new Error('CNN API is not configured. Add CNN_API_URL and CNN_API_TOKEN in Script properties.');
  if (!/^https:\/\/[a-z0-9.-]+\.[a-z]{2,}(:\d+)?$/i.test(url) || /your-|example|placeholder/i.test(url)) {
    throw new Error('CNN_API_URL is not a real address (' + url + '). Set it to your model server address, for example https://lepvision-api.onrender.com');
  }
  return {url: url, token: token};
}

// Calls the model server and turns network failures into a readable message
function cnnFetch_(path, opts) {
  const cfg = cnnConfig_();
  opts = opts || {};
  opts.headers = Object.assign({Authorization: 'Bearer ' + cfg.token}, opts.headers || {});
  opts.muteHttpExceptions = true;
  try {
    return UrlFetchApp.fetch(cfg.url + path, opts);
  } catch (e) {
    throw new Error('Cannot reach the model server at ' + cfg.url + ' (' + String(e.message || e).slice(0, 120) +
      '). Check CNN_API_URL, and that the model service is deployed and running.');
  }
}

function cnnStatus() {
  const res = cnnFetch_('/api/cnn/status', {method: 'get'});
  if (res.getResponseCode() !== 200) throw new Error('Model server responded with HTTP ' + res.getResponseCode());
  return JSON.parse(res.getContentText());
}

// Older single-image endpoint (kept for compatibility)
function classifyImage(actor, imageBase64, mime, analysisType) {
  if (!getUser_(actor)) throw new Error('Please log in first.');
  if (!imageBase64) throw new Error('No image received.');
  if (imageBase64.length > 14 * 1024 * 1024) throw new Error('Image is too large. Please use a smaller photo.');
  const res = cnnFetch_('/api/classify-json', {
    method: 'post', contentType: 'application/json',
    payload: JSON.stringify({analysis_type: analysisType, image_base64: imageBase64, mime: mime || 'image/jpeg'})
  });
  if (res.getResponseCode() !== 200) throw new Error('Model server error ' + res.getResponseCode() + ': ' + res.getContentText().slice(0, 200));
  return JSON.parse(res.getContentText());
}

// ===== MEDIA (photos stored in Google Drive) =====

function getMedia() {
  const o = {};
  sh('Media').getDataRange().getValues().slice(1).forEach(r => { if (r[0]) o[r[0]] = r[1]; });
  return o;
}

const DATASET_PATH = ['Butterfly Dataset', 'images'];

function getDatasetFolder_() {
  let folder = DriveApp.getRootFolder();
  DATASET_PATH.forEach(name => {
    const it = folder.getFoldersByName(name);
    folder = it.hasNext() ? it.next() : folder.createFolder(name);
  });
  return folder;
}

function saveMedia(actor, key, dataUrl) {
  const u = getUser_(actor);
  if (!u || (u.role !== 'breeder' && u.role !== 'admin')) throw new Error('Only breeders and admins can change photos.');
  const m = /^data:(image\/(?:jpeg|png|webp));base64,(.+)$/.exec(String(dataUrl || ''));
  if (!m) throw new Error('Unsupported image format. Use a JPG, PNG or WebP photo.');
  if (m[2].length > 12 * 1024 * 1024) throw new Error('Image is too large (max about 9 MB).');

  const ext = m[1].split('/')[1].replace('jpeg', 'jpg');
  const name = key.replace('|', '_') + '_' + Date.now() + '.' + ext;
  const file = getDatasetFolder_().createFile(Utilities.newBlob(Utilities.base64Decode(m[2]), m[1], name));
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);

  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const s = sh('Media'), v = s.getDataRange().getValues();
    const row = v.findIndex((r, i) => i > 0 && r[0] === key);
    const url = 'https://drive.google.com/thumbnail?id=' + file.getId() + '&sz=w800';
    if (row > 0) {
      const oldId = v[row][2];
      if (oldId) { try { DriveApp.getFileById(oldId).setTrashed(true); } catch (e) {} }
      s.getRange(row + 1, 2, 1, 2).setValues([[url, file.getId()]]);
    } else {
      s.appendRow([key, url, file.getId()]);
    }
    return {url: url, name: name};
  } finally { lock.releaseLock(); }
}

// ===== DASHBOARD (admin only, one-hour token from login) =====

function getDashboardData(token) {
  const actor = CacheService.getScriptCache().get('dashboard:' + String(token || ''));
  if (!actor) throw new Error('Admin login required. Please log in again.');
  requireAdmin_(actor);

  const now = Date.now();
  const userRows = sh('Users').getDataRange().getValues().slice(1).filter(r => r[0]);
  const byRole = {purchaser: 0, buyer: 0, breeder: 0, enthusiast: 0, farmowner: 0, admin: 0};
  userRows.forEach(r => { if (byRole[r[1]] !== undefined) byRole[r[1]]++; });

  const lots = readJson_('Lots'), orders = readJson_('Orders'), res = readRes_();
  const received = orders.filter(o => o.status === 'Received');
  const confirmed = res.filter(r => r.status === 'Confirmed');
  const live = lots.filter(l => l.left > 0 && now < l.exp);
  const bySpecies = {};
  received.forEach(o => { bySpecies[o.sp] = (bySpecies[o.sp] || 0) + o.qty; });

  const activity = sh('Activity').getDataRange().getValues().slice(1)
    .filter(r => r[0]).slice(-40).reverse()
    .map(r => [fmt_(r[0]), r[1], r[2], r[3], r[4]]);

  return {
    updated: fmt_(now),
    users: {
      total: userRows.length, byRole: byRole,
      list: userRows.slice(-100).reverse().map(r => [r[0], r[1], r[2], String(r[3] || ''), String(r[4] || ''), fmt_(r[7])])
    },
    orders: {
      total: orders.length,
      pending: orders.filter(o => o.status === 'Awaiting Payment').length,
      paid: orders.filter(o => o.status === 'Paid – Awaiting Receipt').length,
      revenue: received.reduce((a, o) => a + (o.total || 0), 0),
      list: orders.slice(-50).reverse().map(o => [o.id, o.buyerName || o.buyer, o.sp, o.qty, o.total, o.status, fmt_(o.created)])
    },
    inventory: {
      listings: live.length,
      pupae: live.reduce((a, l) => a + l.left, 0),
      expiring: live.filter(l => l.exp - now < SOON).length,
      list: lots.slice(-50).reverse().map(l => [l.sp, l.breeder, l.qty, l.left, l.price, fmt_(l.exp)])
    },
    reservations: {
      total: res.length,
      pending: res.filter(r => r.status === 'Awaiting Approval' || r.status === 'Payment Submitted' || r.status === 'Pending Payment').length,
      confirmed: confirmed.length,
      revenue: confirmed.reduce((a, r) => a + (r.total || 0), 0),
      list: res.slice(-50).reverse().map(r => [r.ref, r.name, r.farm, r.date, r.slot, r.n, r.total, r.status])
    },
    salesRecord: received.slice()
      .sort((a, b) => (b.receivedAt || b.created || 0) - (a.receivedAt || a.created || 0))
      .map(o => ({id: o.id, date: o.receivedAt || o.created, sp: o.sp, qty: o.qty, price: o.price,
        total: o.total, breeder: o.breeder, sellerName: o.sellerName || o.breeder,
        buyer: o.buyer, buyerName: o.buyerName || o.buyer})),
    sales: bySpecies,
    activity: activity
  };
}

