function requireAdmin_(actor) {
  const u = getUser_(actor);
  if (!u || u.role !== 'admin') throw new Error('Administrator access only.');
  return u;
}

function updateOwnProfile(actor, d) {
  const u = getUser_(actor);
  if (!u) throw new Error('Please log in first.');
  d = d || {};
  const name = String(d.name || '').trim(), phone = String(d.phone || '').trim();
  if (!name || phone.length < 7) throw new Error('Name and a valid phone number are required.');
  const f = {name: name, phone: phone, email: String(d.email || '').trim(),
    organization: String(d.organization || '').trim(), address: String(d.address || '').trim()};
  if (['breeder', 'farmowner', 'admin'].indexOf(u.role) > -1) f.gcash = String(d.gcash || '').replace(/\s/g, '');
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try { setUserFields_(actor, f); } finally { lock.releaseLock(); }
  return {ok: true};
}

function markSeen(actor, ts) {
  if (!getUser_(actor)) return false;
  setUserFields_(actor, {seen: Number(ts) || Date.now()});
  return true;
}

