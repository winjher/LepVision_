function doGet(e) {
  ss_();
  const p = (e && e.parameter) || {};
  if (p.fn === 'ping') {
    return ContentService.createTextOutput(JSON.stringify({result: 'pong'})).setMimeType(ContentService.MimeType.JSON);
  }
  if (p.fn === 'diag') {
    return ContentService.createTextOutput(JSON.stringify(diagnose_(p.key))).setMimeType(ContentService.MimeType.JSON);
  }
  const isDash = p.page === 'dashboard';
  const t = HtmlService.createTemplateFromFile(isDash ? 'Dashboard' : 'Index');
  t.appUrl = ScriptApp.getService().getUrl();
  // Tokens are hex only; strip anything else so the value is safe inside the page
  t.token = String(p.token || '').replace(/[^a-f0-9]/gi, '');
  return t.evaluate()
    .setTitle(isDash ? 'Butterfly Shop Dashboard' : 'Butterfly Pupae Shop & Park')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1, viewport-fit=cover')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// Used by the GitHub Pages / Android app (JSON posts). Every name here must be a global function.
function doPost(e) {
  const api = {
    login, getState, saveState, logActivity, getMedia, saveMedia, listPhotos, cnnStatus, classifyImage,
    requestReservation, updateReservation, getMessages, sendMessage,
    updateOwnProfile, markSeen, changeMyPassword,
    adminListUsers, adminCreateFarmOwner, adminUpdateUser,
    setCatalogItem, postFreshPupae, setLotLeft, placeOrder, updateOrder,
    setFarmCapacity, updateMyFarm, adminSaveFarm,
    classifyAndSave, datasetStatus, listButterfliesFound, exportManifest, writeLabelFiles
  };
  let out;
  try {
    const req = JSON.parse(e.postData.contents);
    const fn = api[req.fn];
    if (!fn) throw new Error('Unknown function: ' + req.fn);
    out = {result: fn.apply(null, req.args || [])};
  } catch (err) {
    out = {error: String(err.message || err)};
  }
  return ContentService.createTextOutput(JSON.stringify(out)).setMimeType(ContentService.MimeType.JSON);
}

// Lists image files in Butterfly Dataset/images for the catalog.
// Files are shared "anyone with link" so the catalog can display them.
function listPhotos() {
  const out = [];
  const files = getDatasetFolder_().getFiles();
  while (files.hasNext()) {
    const f = files.next();
    if (!/^image\//.test(f.getMimeType())) continue;
    try {
      if (f.getSharingAccess() !== DriveApp.Access.ANYONE_WITH_LINK) {
        f.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      }
    } catch (e) {}
    out.push({
      name: f.getName(),
      url: 'https://drive.google.com/thumbnail?id=' + f.getId() + '&sz=w800',
      updated: f.getLastUpdated().getTime()
    });
  }
  return out;
}

// ===== SHEETS =====

function ss_() {
  if (SS_CACHE) return SS_CACHE;
  let ss = null;
  try { ss = SpreadsheetApp.getActiveSpreadsheet(); } catch (e) {}
  const props = PropertiesService.getScriptProperties();
  if (!ss) {
    const id = SHEET_ID || props.getProperty('SHEET_ID');
    try { if (id) ss = SpreadsheetApp.openById(id); } catch (e) {}
  }
  if (!ss) {
    ss = SpreadsheetApp.create('Butterfly Shop Data');
    props.setProperty('SHEET_ID', ss.getId());
  }
  SS_CACHE = ss;
  ensureTabs_(ss);
  return ss;
}

function ensureTabs_(ss) {
  Object.keys(HDR).forEach(name => {
    let s = ss.getSheetByName(name);
    if (!s) s = ss.insertSheet(name);
    const need = HDR[name];
    if (s.getLastRow() === 0) {
      s.appendRow(need);
    } else {
      const cur = s.getRange(1, 1, 1, Math.max(s.getLastColumn(), need.length)).getValues()[0];
      need.forEach((h, i) => { if (cur[i] !== h) s.getRange(1, i + 1).setValue(h); });
    }
    s.setFrozenRows(1);
    s.getRange(1, 1, 1, need.length).setFontWeight('bold');
  });
  const blank = ss.getSheetByName('Sheet1');
  if (blank && ss.getSheets().length > 1 && blank.getLastRow() === 0) ss.deleteSheet(blank);
}

function sh(name) { return ss_().getSheetByName(name); }

// ===== UTILITIES =====

function hash_(pw, salt) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, salt + pw)
    .map(b => ('0' + (b & 0xff).toString(16)).slice(-2)).join('');
}

function fmt_(v) {
  if (v instanceof Date) return v.toISOString();
  if (typeof v === 'number') return new Date(v).toISOString();
  return String(v || '');
}

function today_() { return Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd'); }

function readJson_(name) {
  const v = sh(name).getDataRange().getValues();
  const j = HDR[name].length - 1;
  return v.slice(1).map(r => { try { return JSON.parse(r[j]); } catch (e) { return null; } }).filter(Boolean);
}

function upsert_(name, key, items, toRow) {
  if (!items || !items.length) return;
  const s = sh(name), v = s.getDataRange().getValues(), j = HDR[name].length - 1;
  const idx = {};
  v.slice(1).forEach((r, k) => { idx[String(r[0])] = {row: k + 2, json: r[j]}; });
  const add = [];
  items.forEach(it => {
    const js = JSON.stringify(it);
    const hit = idx[String(it[key])];
    if (hit && hit.json === js) return;
    const row = toRow(it).concat(js);
    if (hit) s.getRange(hit.row, 1, 1, row.length).setValues([row]);
    else add.push(row);
  });
  if (add.length) s.getRange(s.getLastRow() + 1, 1, add.length, add[0].length).setValues(add);
}

function cfg_(key) {
  const row = sh('Config').getDataRange().getValues().find(r => r[0] === key);
  try { return row ? JSON.parse(row[1]) : null; } catch (e) { return null; }
}

function setConfig_(key, val) {
  const cs = sh('Config'), cv = cs.getDataRange().getValues();
  const k = cv.findIndex((r, i) => i > 0 && r[0] === key);
  const json = JSON.stringify(val);
  if (k > 0) cs.getRange(k + 1, 2).setValue(json);
  else cs.appendRow([key, json]);
}

function logLogin_(u, role, result) { sh('Logins').appendRow([new Date(), u, role, result]); }

function logActivity(username, role, action, detail) {
  sh('Activity').appendRow([new Date(), String(username || '-'), String(role || '-'),
    String(action || ''), String(detail || '').slice(0, 500)]);
  return true;
}

// ===== USERS & AUTH =====

function toUser_(r, row) {
  return {
    row: row, username: r[0], role: r[1], name: r[2], phone: r[3], email: r[4], gcash: r[5],
    seen: Number(r[6]) || 0, created: r[7], organization: r[12] || '', address: r[13] || '',
    farm: r[14] || '', idType: r[15] || '', idNo: r[16] || '', mustChange: Number(r[17]) || 0
  };
}

// What other users may see. Buyer addresses stay private.
function publicUser_(u) {
  const hideAddr = BUYER_ROLES.indexOf(u.role) > -1;
  return {role: u.role, name: u.name, org: u.organization, address: hideAddr ? '' : u.address, farm: u.farm, gcash: u.gcash};
}

// What a user sees about themselves
function fullUser_(u) {
  return Object.assign(publicUser_(u), {username: u.username, phone: u.phone, email: u.email, seen: u.seen,
    idType: u.idType, address: u.address, mustChange: u.mustChange || 0});
}

function readUsers_() {
  return sh('Users').getDataRange().getValues().slice(1)
    .map((r, i) => toUser_(r, i + 2)).filter(u => u.username);
}

function getUser_(name) {
  return name ? (readUsers_().find(u => u.username === name) || null) : null;
}

function setUserFields_(username, obj) {
  const u = getUser_(username);
  if (!u) throw new Error('User not found.');
  const s = sh('Users');
  Object.keys(obj).forEach(k => { if (UCOL[k]) s.getRange(u.row, UCOL[k]).setValue(obj[k]); });
}

// Caller must hold the lock
function registerUser_(role, u, pw, x) {
  const s = sh('Users'), v = s.getDataRange().getValues();
  if (v.some((r, i) => i > 0 && String(r[0]).toLowerCase() === u)) return {ok: false, msg: 'That username is taken. Please log in or choose another.'};
  if (ALL_ROLES.indexOf(role) < 0) return {ok: false, msg: 'Please choose an account type.'};
  const name = String(x.name || '').trim(), phone = String(x.phone || '').trim();
  const org = String(x.org || '').trim(), addr = String(x.addr || '').trim(), email = String(x.email || '').trim();
  const idType = String(x.idType || ''), idNo = String(x.idNo || '').replace(/\s/g, '');
  if (!name || phone.length < 7) return {ok: false, msg: 'Registration needs your full name and phone number.'};
  if (role === 'buyer') {
    if (!email || !addr) return {ok: false, msg: 'Buyer registration needs your email and address.'};
    if (ID_TYPES.indexOf(idType) < 0 || idNo.length < 5) return {ok: false, msg: 'Choose your valid ID type and enter the ID number.'};
  } else if (role !== 'enthusiast' && (!org || !addr)) {
    return {ok: false, msg: 'Registration needs your ' + (role === 'breeder' ? 'farm / business name' : 'company / buyer name') + ' and address.'};
  }

  // A breeder's farm is designated at registration: the business name becomes the farm name
  let farmName = '';
  if (role === 'breeder') {
    if (farmExists_(org)) return {ok: false, msg: 'A farm named "' + org + '" already exists. Add a branch name, for example "' + org + ' – Branch 2".'};
    farmName = org;
    saveFarmProfile_(farmName, cleanFarmProfile_(farmName, {loc: addr, tel: phone, hours: '8:00 AM - 5:00 PM', p: 150, c: 20, sp: ''}));
  }

  const isBuyer = role === 'buyer';
  const salt = Utilities.getUuid();
  const row = [u, role, name, phone, email, '', 0, new Date(), new Date(), 1,
    hash_(pw, salt), salt, org, addr, farmName, isBuyer ? idType : '', isBuyer ? idNo : '', 0];
  s.appendRow(row);
  logLogin_(u, role, 'REGISTERED');
  logActivity(u, role, 'Registered', role + ' | ' + (org || name));
  return {ok: true, user: fullUser_(toUser_(row, v.length + 1))};
}

function login(role, username, pw, extra) {
  extra = extra || {};
  const u = String(username || '').trim().toLowerCase();
  pw = String(pw || '');
  if (u.length < 3 || pw.length < 4) return {ok: false, msg: 'Username 3+ and password 4+ characters.'};

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    if (extra.mode === 'register') {
      if (SELF_ROLES.indexOf(role) < 0) return {ok: false, msg: 'Please choose an account type.'};
      return registerUser_(role, u, pw, extra);
    }
    bootstrapAccounts_();   // creates missing admin / farm owner accounts from Script properties
    const s = sh('Users'), v = s.getDataRange().getValues();
    const i = v.findIndex((r, k) => k > 0 && String(r[0]).toLowerCase() === u);
    if (i < 0) { logLogin_(u, '', 'FAILED (no account)'); return {ok: false, msg: 'No account for that username. Please register first.'}; }
    const r = v[i];
    if (hash_(pw, r[11]) !== r[10]) { logLogin_(u, r[1], 'FAILED'); return {ok: false, msg: 'Wrong password.'}; }
    s.getRange(i + 1, 9, 1, 2).setValues([[new Date(), (Number(r[9]) || 0) + 1]]);
    logLogin_(u, r[1], 'OK');
    logActivity(u, r[1], 'Login', '');
    const dashboardToken = r[1] === 'admin' ? issueDashboardToken_(u) : '';
    return {ok: true, user: fullUser_(toUser_(r, i + 1)), dashboardToken: dashboardToken};
  } finally {
    lock.releaseLock();
  }
}

// Creates missing admin / farm owner accounts listed in BOOTSTRAP_ACCOUNTS.
// Existing accounts are never changed here. These accounts must change their password at first login.
function bootstrapAccounts_() {
  const raw = PropertiesService.getScriptProperties().getProperty('BOOTSTRAP_ACCOUNTS');
  if (!raw) return;
  let list;
  try { list = JSON.parse(raw); } catch (e) { throw new Error('BOOTSTRAP_ACCOUNTS is not valid JSON.'); }
  const s = sh('Users'), v = s.getDataRange().getValues();
  const have = {};
  v.slice(1).forEach(r => { have[String(r[0]).toLowerCase()] = true; });
  list.forEach(a => {
    const u = String(a.username || '').trim().toLowerCase();
    if (!u || have[u] || !a.password) return;
    if (['admin', 'farmowner'].indexOf(a.role) < 0) return;
    if (a.role === 'farmowner' && !farmExists_(a.farm)) return;
    const salt = Utilities.getUuid(), now = new Date();
    const vals = {
      username: u, role: a.role, name: a.name || u, phone: a.phone || '0000000', email: a.email || '',
      gcash: '', seen: 0, created: now, lastLogin: '', logins: 0,
      pwHash: hash_(String(a.password), salt), salt: salt,
      organization: a.organization || '', address: a.address || '', farm: a.farm || '',
      idType: '', idNo: '', mustChange: 1
    };
    s.appendRow(HDR.Users.map(h => vals[h] !== undefined ? vals[h] : ''));
    have[u] = true;
    logActivity('system', 'system', 'Bootstrap account', u + ' (' + a.role + ')');
  });
}

// Any logged-in user changes their own password. The current password must be entered.
function changeMyPassword(actor, oldPw, newPw) {
  const u = getUser_(actor);
  if (!u) throw new Error('Please log in first.');
  oldPw = String(oldPw || '');
  newPw = String(newPw || '');
  if (newPw.length < 8) throw new Error('Use at least 8 characters.');
  if (newPw === oldPw) throw new Error('Choose a password different from the current one.');
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const s = sh('Users');
    const pair = s.getRange(u.row, 11, 1, 2).getValues()[0];   // [pwHash, salt]
    if (hash_(oldPw, pair[1]) !== pair[0]) throw new Error('The current password is wrong.');
    const salt = Utilities.getUuid();
    s.getRange(u.row, 11, 1, 2).setValues([[hash_(newPw, salt), salt]]);
    s.getRange(u.row, 18).setValue(0);
  } finally { lock.releaseLock(); }
  logActivity(actor, u.role, 'Changed password', '');
  return {ok: true};
}

// ===== DASHBOARD TOKENS (admin only, one hour) =====

function issueDashboardToken_(username) {
  const token = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '');
  CacheService.getScriptCache().put('dashboard:' + token, username, DASH_TOKEN_SECONDS);
  return token;
}

// Setup check. Open: <web app URL>?fn=diag&key=YOUR_ADMIN_KEY
function diagnose_(key) {
  const want = PropertiesService.getScriptProperties().getProperty('ADMIN_KEY');
  if (!want || key !== want) return {error: 'Wrong key.'};
  return {
    spreadsheet: ss_().getUrl(),
